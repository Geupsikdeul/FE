{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "buildCommand": "",
  "outputDirectory": "frontend",
  "redirects": [
    { "source": "/", "destination": "/home", "permanent": false }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://geupsikdeul-be.vercel.app/api/:path*" },
    { "source": "/admin", "destination": "/pages/admin/dashboard.html" },
    { "source": "/admin/:page", "destination": "/pages/admin/:page.html" },
    { "source": "/:page", "destination": "/pages/student/:page.html" }
  ]
}
